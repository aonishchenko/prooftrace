# Copy to .env (gitignored) and fill in. Never commit real values.
# Local dev: wrangler/vite read .env for Worker secrets.
# Deployed Worker: set each secret with `npx wrangler secret put <NAME>`.

# Optional: Brave Web Search API key. Without it ProofTrace runs in "limited search" mode.
BRAVE_SEARCH_API_KEY=

# Optional for CI/non-interactive deploys (a scoped Cloudflare API token). Local deploys use `wrangler login`.
CLOUDFLARE_API_TOKEN=

# Used by scripts/e2e.mjs
BASE_URL=https://prooftrace.aonishchenko33.workers.dev
